{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pinDigests": false,
  "gitAuthor": "Renovate Bot <{{GITHUB_OWNER}}@users.noreply.github.com>",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge non-major updates in a single grouped PR",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "non-major dependencies",
      "commitMessageTopic": "dependencies",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Major updates: one pull request each, never automerged; the upgrade routine reads the changelog, applies the code changes, deploys to staging and merges",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"],
      "automerge": false
    },
    {
      "description": "The stack package: never automerged; the upgrade routine applies its migrations and merges",
      "matchPackageNames": ["@moifort/stack"],
      "labels": ["dependencies", "stack"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"],
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash"
  }
}
