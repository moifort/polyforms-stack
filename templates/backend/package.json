{
  "name": "{{APP_SLUG}}",
  "private": true,
  "scripts": {
    "prepare": "bun run generate:assets && nitro prepare",
    "build": "bun run generate:assets && nitro build",
    "dev": "bun run generate:assets && nitro dev --host 0.0.0.0",
    "typecheck": "bunx nitro prepare && bunx tsc --noEmit",
    "test": "bun run generate:assets && bun test",
    "test:unit": "bun run generate:assets && bun test .unit.test",
    "test:int": "bun run generate:assets && bun test .int.test",
    "test:feat": "bun run generate:assets && bun test .feat.test",
    "test:coverage": "bun run generate:assets && bun test --coverage",
    "lint": "bunx biome check",
    "lint:fix": "bunx biome check --write",
    "preflight": "bun run typecheck && bun run lint && bun run test:unit && bun run test:int && bun run test:feat",
    "generate:assets": "bun scripts/generate-changelog-asset.ts",
    "generate:graphql": "bun scripts/export-graphql-schema.ts",
    "generate": "bun run generate:assets && bun run generate:graphql",
    "deprecations": "bun scripts/deprecations.ts",
    "schema:check": "graphql-inspector diff \"git:${SCHEMA_BASE:-origin/main}:shared/schema.graphql\" shared/schema.graphql --rule suppressRemovalOfDeprecatedField --rule ./scripts/deprecations/inspector-rule.ts",
    "stack:check": "bunx stack check",
    "infra:build": "bun install --frozen-lockfile && bunx nitro prepare && bun run generate:graphql && bun run build",
    "infra:init": "cd infra && ../scripts/tf init",
    "infra:plan": "bun run infra:build && cd infra && ../scripts/tf plan"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@graphql-inspector/cli": "7.0.2",
    "@moifort/stack": "{{STACK_VERSION}}",
    "@types/bun": "1.4.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.5",
    "bun-types": "1.4.3",
    "h3": "1.15.11",
    "nitropack": "2.13.5",
    "ts-brand": "0.2.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@pothos/core": "4.15.1",
    "@sentry/node": "11.8.0",
    "consola": "3.4.2",
    "firebase-admin": "13.10.0",
    "graphql": "16.14.2",
    "lodash-es": "4.18.1",
    "ts-pattern": "5.9.2",
    "zod": "4.6.7"
  }
}
