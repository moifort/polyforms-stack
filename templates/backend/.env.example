# Bearer token guarding /admin/* (migrations, scheduled routes). Any string locally.
NITRO_ADMIN_TOKEN=your-admin-token
# Sentry DSN of the <app>-node project. Blank disables reporting; never set in dev.
NITRO_SENTRY_DSN=
# Sentry user auth token, for the local error triage tooling only (read + resolve
# issues through the REST API). Not a runtime setting.
SENTRY_AUTH_TOKEN=
# Dev-only: the Firebase UID the auth bypass signs requests as, so Apollo Sandbox
# works without a token.
NITRO_DEV_USER_ID=
