{
  "name": "@moifort/stack",
  "version": "0.1.0",
  "description": "The Polyforms stack: rules, skills, hooks, routines and templates for a Firebase + iOS app, versioned and upgraded through Renovate.",
  "license": "MIT",
  "repository": "github:moifort/polyforms-stack",
  "type": "module",
  "bin": {
    "stack": "bin/stack.ts"
  },
  "files": [
    "bin",
    "src",
    "rules",
    "skills",
    "hooks",
    "routines",
    "templates",
    "migrations",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test .unit.test",
    "test:int": "bun test .int.test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check",
    "lint:fix": "bunx biome check --write",
    "validate": "bun src/validate-content.ts",
    "preflight": "bun run typecheck && bun run lint && bun run test:unit && bun run test:int && bun run validate"
  },
  "dependencies": {
    "semver": "7.7.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/semver": "7.7.1",
    "typescript": "5.9.3"
  }
}
